# RubricJudge - Environment Variables
# Copy this file to .env and fill in your values.

# -- LLM Provider --------------------------------------------------------------
# Options: "gemini" | "openai" | "anthropic" | "ollama"
LLM_PROVIDER=gemini

# Google Gemini (FREE tier - default)
# Get your free API key at: https://aistudio.google.com/apikey
# Multiple comma-separated keys supported for automatic round-robin rotation:
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (optional alternative)
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o

# Anthropic Claude (optional alternative)
# ANTHROPIC_API_KEY=your-anthropic-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (local fallback - no key needed)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3

# -- Retry & Backoff -----------------------------------------------------------
LLM_MAX_RETRIES=3
LLM_BASE_BACKOFF=2.0

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
